{
  "name": "@many-rooms/mobile",
  "version": "0.1.0",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/node": "24.19.2",
    "@types/react": "~19.2.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "3.9.9",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:adapter && npm run test:components",
    "build": "expo export --platform android --output-dir dist",
    "check:dependencies": "expo install --check",
    "test:adapter": "node --test --test-isolation=none tests/*.test.ts",
    "test:components": "jest --runInBand",
    "build:web": "expo export --platform web --output-dir dist-web"
  },
  "private": true
}
