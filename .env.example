# Run `npm run setup` to generate .env with a unique local database password.
# This file contains configuration examples, not credentials.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=manyrooms
POSTGRES_USER=manyrooms
POSTGRES_PASSWORD=
# Demo is deliberately limited to Development. Production identity is not implemented.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
Demo__Enabled=true
